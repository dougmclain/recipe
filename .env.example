# Django Recipe App - Environment Variables

# Hugging Face API Token (required for AI image generation)
# Get your free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_token_here

# Django Secret Key (for production)
# SECRET_KEY=your-secret-key-here

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma separated)
ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com

# CSRF Trusted Origins (Required for Cloudflare Tunnel - include https://)
CSRF_TRUSTED_ORIGINS=http://127.0.0.1,https://your-domain.com

# Database settings (if using PostgreSQL or MySQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
